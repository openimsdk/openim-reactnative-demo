# Android emulators typically use 10.0.2.2 to reach services on the host Mac.
# Physical devices need a LAN-reachable host or HTTPS/WSS endpoints.
EXPO_PUBLIC_BASE_DOMAIN=127.0.0.1

# Set these only when the service endpoints do not share the base domain above.
# EXPO_PUBLIC_CHAT_URL=http://127.0.0.1:10008
# EXPO_PUBLIC_API_URL=http://127.0.0.1:10002
# EXPO_PUBLIC_WS_URL=ws://127.0.0.1:10001
